# -----------------------------------------------------------------------------
# Anima environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# --- SQL Server system administrator (SA) password ---------------------------
# Must satisfy SQL Server complexity: >= 8 chars, upper + lower + digit/symbol.
MSSQL_SA_PASSWORD=Change_Me_Str0ng!

# --- Application database credentials -----------------------------------------
# For local dev these can point at the SA account, or a dedicated app login.
DB_NAME=anima
DB_USER=sa
DB_PASSWORD=Change_Me_Str0ng!

# --- Fernet symmetric encryption key ------------------------------------------
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
