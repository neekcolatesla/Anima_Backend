# Anima backend - environment configuration (copy to .env and fill in).
# .env is git-ignored; never commit real secrets.

# --- SQL Server ---------------------------------------------------------------
# SA password: upper + lower + digit/symbol, 8+ chars.
MSSQL_SA_PASSWORD=Change_Me_Str0ng!
DB_NAME=anima
DB_USER=sa
DB_PASSWORD=Change_Me_Str0ng!          # same as MSSQL_SA_PASSWORD for local dev

# Host vs container:
#   DB_HOST=localhost -> running Python from your Windows .venv
#   DB_HOST=db        -> code running INSIDE the api container
DB_HOST=localhost
DB_PORT=1433

# --- Field-level encryption ---------------------------------------------------
# Fernet key for encrypting patient names at rest. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=PASTE_GENERATED_KEY_HERE
